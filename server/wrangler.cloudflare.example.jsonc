{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edish",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../docs", "binding": "ASSETS", "run_worker_first": ["/api/*", "/src/config.js"] },
  "vars": { "AUTH_PROVIDER": "cloudflare" },
  "d1_databases": [{ "binding": "DB", "database_name": "edish", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }],
  "triggers": { "crons": ["17 * * * *"] }
}
